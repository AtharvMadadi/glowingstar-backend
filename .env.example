# Copy to .env and fill in. .env is gitignored and must never be committed.
DATABASE_URL=postgresql://gs:gsdev@localhost:5432/glowingstar

# Leave blank for local development — the app generates an ephemeral secret
# at boot. Required in production; startup fails without it.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

ENVIRONMENT=development
